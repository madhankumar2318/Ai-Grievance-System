{
  "name": "ai-grievance-system-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI Grievance System - Monorepo containing Next.js Frontend and Spring Boot Backend",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "mvn -f backend/pom.xml spring-boot:run",
    "build:backend": "mvn -f backend/pom.xml test-compile"
  }
}
